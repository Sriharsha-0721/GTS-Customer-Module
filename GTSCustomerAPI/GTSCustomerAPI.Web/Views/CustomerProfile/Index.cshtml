        async function loadGarmentTypes() {

            const ddl =
                document.getElementById(
                    "newWashGarmentType"
                );

            if (!ddl) {
                return;
            }

            try {

                const response =
                    await fetch(
                        "/CustomerProfile/GetGarmentTypes"
                    );

                console.log(
                    "Garment types response status:",
                    response.status
                );

                if (!response.ok) {

                    const message =
                        await response.text();

                    console.error(
                        "Failed to load Garment Types:",
                        message
                    );

                    return;
                }

                const data =
                    await response.json();

                console.log(
                    "Garment Types:",
                    data
                );

                ddl.innerHTML =
                    '<option value="">Select Garment Type</option>';

                // Show each ItemDesc only once.
                const seen =
                    new Set();

                (data || []).forEach(
                    function (item) {

                        const itemDesc =
                            (item.itemDesc || "")
                                .trim();

                        if (!itemDesc) {
                            return;
                        }

                        const key =
                            itemDesc.toLowerCase();

                        if (seen.has(key)) {
                            return;
                        }

                        seen.add(key);

                        const option =
                            document.createElement(
                                "option"
                            );

                        option.value =
                            itemDesc;

                        option.textContent =
                            itemDesc;

                        ddl.appendChild(
                            option
                        );
                    }
                );

                console.log(
                    "Garment Type dropdown options:",
                    ddl.options.length
                );
            }
            catch (error) {

                console.error(
                    "Garment Type error:",
                    error
                );
            }
        }


        function showWashAddRow() {

            const row =
                document.getElementById(
                    "washAddRow"
                );

            if (row) {
                row.style.display =
                    "table-row-group";
            }

            loadGarmentTypes();
        }


        function cancelWashRow() {

            const row =
                document.getElementById(
                    "washAddRow"
                );

            const garment =
                document.getElementById(
                    "newWashGarmentType"
                );

            const formula =
                document.getElementById(
                    "newWashFormula"
                );

            if (garment) {
                garment.value = "";
            }

            if (formula) {
                formula.value = "";
            }

            if (row) {
                row.style.display = "none";
            }
        }


        function saveWashRow() {

            const garmentElement =
                document.getElementById(
                    "newWashGarmentType"
                );

            const formulaElement =
                document.getElementById(
                    "newWashFormula"
                );

            if (!garmentElement ||
                !formulaElement) {
                return;
            }

            const garmentType =
                garmentElement.value.trim();

            const formula =
                formulaElement.value.trim();

            if (!garmentType) {

                alert(
                    "Please select Garment Type."
                );

                return;
            }

            if (!formula) {

                alert(
                    "Please enter Formula."
                );

                return;
            }

            // If the garment already exists, update its formula.
            const existingIndex =
                washData.findIndex(
                    function (x) {
                        return x.garmentType
                            .toLowerCase()
                            === garmentType
                                .toLowerCase();
                    }
                );

            if (existingIndex >= 0) {
                washData[existingIndex]
                    .formula = formula;
            }
            else {
                washData.push({
                    garmentType:
                        garmentType,
                    formula:
                        formula
                });
            }

            renderWashRows();
            buildWashFormula();
            buildWashComment();
            cancelWashRow();

            const message =
                document.getElementById(
                    "washMessage"
                );

            // if (message) {
            //     message.innerText =
            //         "Wash row added. Click the main Save button to save Customer Profile.";
            // }
        }


        function buildWashFormula() {

            const formulaString =
                washData
                    .map(
                        function (x) {
                            return (
                                x.garmentType
                                + ","
                                + x.formula
                            );
                        }
                    )
                    .join(",");

            const hidden =
                document.getElementById(
                    "FormulaData"
                );

            if (hidden) {
                hidden.value =
                    formulaString;
            }

            console.log(
                "Wash FormulaData:",
                formulaString
            );

            return formulaString;
        }


        function buildWashComment() {

            const hidden =
                document.getElementById("hid_Wash");

            const title =
                document.getElementById("sectionTitle");

            const commentBox =
                document.getElementById("txtComment");

            let existingText = "";

            if (
                title &&
                title.innerText.trim() === "Wash" &&
                commentBox
            ) {
                existingText = commentBox.value || "";
            }
            else if (hidden) {
                existingText = hidden.value || "";
            }

            const heading =
                existingText.includes("Wash Details:")
                    ? "Wash Details:"
                    : "Wash Details";

            const parts =
                extractGeneratedCommentParts(
                    existingText,
                    heading,
                    function (line) {
                        // Wash-generated rows use "Garment Type : Formula".
                        return /^.+?\s+:\s+.+?,?\s*$/.test(line);
                    }
                );

            const generatedLines = (washData || []).map(
                function (x) {
                    return (
                        x.garmentType
                        + " : "
                        + x.formula
                        + ","
                    );
                }
            );

            let finalComment = "";

            if (generatedLines.length > 0) {
                finalComment = "Wash Details:";

                if (parts.headingText) {
                    finalComment += parts.headingText;
                }
                else if (parts.beforeText) {
                    finalComment += parts.beforeText;
                }

                finalComment += "\n" + generatedLines.join("\n");

                if (parts.afterText) {
                    finalComment += "\n" + parts.afterText;
                }
            }
            else {
                finalComment = [
                    parts.headingText,
                    parts.beforeText,
                    parts.afterText
                ]
                .filter(Boolean)
                .join("\n")
                .trim();
            }

            setSectionComment(
                "hid_Wash",
                "Wash",
                finalComment.trim()
            );

            console.log("WashCom:", finalComment.trim());

            return finalComment.trim();
        }



        function renderWashRows() {

            const tbody =
                document.getElementById(
                    "washRows"
                );

            if (!tbody) {
                return;
            }

            tbody.innerHTML = "";

            if (washData.length === 0) {

                tbody.innerHTML = `
                    <tr>
                        <td colspan="3"
                            class="text-center text-muted">
                            No Wash formulas found.
                        </td>
                    </tr>
                `;

                return;
            }

            washData.forEach(
                function (item, index) {

                    const row =
                        document.createElement(
                            "tr"
                        );

                    const garmentTd =
                        document.createElement(
                            "td"
                        );

                    garmentTd.textContent =
                        item.garmentType;

                    row.appendChild(
                        garmentTd
                    );

                    const formulaTd =
                        document.createElement(
                            "td"
                        );

                    formulaTd.textContent =
                        item.formula;

                    row.appendChild(
                        formulaTd
                    );

                    const actionTd =
                        document.createElement(
                            "td"
                        );

                    actionTd.className =
                        "text-center";

                    const deleteButton =
                        document.createElement(
                            "button"
                        );

                    deleteButton.type =
                        "button";

                    deleteButton.className =
                        "gts-delete-btn";

                    deleteButton.title =
                        "Delete";

                    deleteButton.textContent =
                        "🗑";

                    deleteButton.onclick =
                        function () {
                            deleteWashRow(
                                index
                            );
                        };

                    actionTd.appendChild(
                        deleteButton
                    );

                    row.appendChild(
                        actionTd
                    );

                    tbody.appendChild(
                        row
                    );
                }
            );
        }


        function deleteWashRow(index) {

            if (index < 0 ||
                index >= washData.length) {
                return;
            }

            washData.splice(
                index,
                1
            );

            renderWashRows();
            buildWashFormula();
            buildWashComment();
        }


        function loadExistingWashFormula() {

            const hidden =
                document.getElementById(
                    "FormulaData"
                );

            if (!hidden) {
                return;
            }

            const value =
                (hidden.value || "")
                    .trim();

            washData = [];

            if (!value) {
                renderWashRows();
                return;
            }

            const parts =
                value
                    .split(",")
                    .map(
                        function (x) {
                            return x.trim();
                        }
                    );

            for (
                let i = 0;
                i + 1 < parts.length;
                i += 2
            ) {

                const garmentType =
                    parts[i] || "";

                const formula =
                    parts[i + 1] || "";

                if (garmentType &&
                    formula) {

                    washData.push({
                        garmentType:
                            garmentType,
                        formula:
                            formula
                    });
                }
            }

            renderWashRows();
            buildWashComment();

            console.log(
                "Existing Wash Data:",
                washData
            );
        }
    </script>
}