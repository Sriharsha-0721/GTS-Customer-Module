        // =====================================================
        // COMMENT HELPERS FOR GENERATED SECTIONS
        // =====================================================

        function extractGeneratedCommentParts(
            existingText,
            heading,
            isGeneratedLine
        ) {
            const normalized = String(existingText || "")
                .replace(/\r/g, "");

            const lines = normalized.split("\n");

            let headingText = "";
            const beforeLines = [];
            const afterLines = [];
            let generatedStarted = false;

            lines.forEach(function (rawLine) {
                let line = rawLine;
                const headingIndex = line.lastIndexOf(heading);

                if (headingIndex >= 0) {
                    const afterHeading = line
                        .substring(headingIndex + heading.length)
                        .trim();

                    if (afterHeading && !isGeneratedLine(afterHeading)) {
                        // Keep the most recently typed inline heading text.
                        headingText = afterHeading;
                    }
                    return;
                }

                const trimmed = line.trim();

                if (!trimmed) {
                    return;
                }

                if (isGeneratedLine(trimmed)) {
                    generatedStarted = true;
                    return;
                }

                if (generatedStarted) {
                    afterLines.push(trimmed);
                }
                else {
                    beforeLines.push(trimmed);
                }
            });

            return {
                headingText: headingText,
                beforeText: beforeLines.join("\n").trim(),
                afterText: afterLines.join("\n").trim()
            };
        }

        function setSectionComment(
            hiddenId,
            sectionName,
            finalComment
        ) {
            const hidden = document.getElementById(hiddenId);
            const commentBox = document.getElementById("txtComment");
            const title = document.getElementById("sectionTitle");
            const charInfo = document.getElementById("charInfo");

            if (hidden) {
                hidden.value = finalComment;
            }

            if (
                title &&
                title.innerText.trim() === sectionName &&
                commentBox
            ) {
                commentBox.value = finalComment;

                if (charInfo) {
                    charInfo.innerText =
                        finalComment.length +
                        " / 750 characters";
                }
            }
        }

        function buildBillingComment() {

            const hidden =
                document.getElementById("hid_Billing");

            const commentBox =
                document.getElementById("txtComment");

            const title =
                document.getElementById("sectionTitle");

            let existingText = "";

            if (
                title &&
                title.innerText.trim() === "Billing" &&
                commentBox
            ) {
                existingText = commentBox.value || "";
            }
            else if (hidden) {
                existingText = hidden.value || "";
            }

            // IMPORTANT:
            // A Billing generated row always looks like:
            // Charge Type : 2.43,
            // Therefore a deleted charge line is removed from the
            // comment even though it is no longer present in billingData.
            const parts =
                extractGeneratedCommentParts(
                    existingText,
                    "Billing Details:",
                    function (line) {
                        return /^.+?\s*:\s*-?\d+(?:\.\d+)?\s*,?\s*$/.test(line);
                    }
                );

            const billingLines = (billingData || []).map(
                function (item) {
                    const amount =
                        (parseFloat(item.charges) || 0)
                            .toFixed(2);

                    return (
                        item.chargeType
                        + " : "
                        + amount
                        + ","
                    );
                }
            );

            let finalComment = "";

            if (billingLines.length > 0) {
                finalComment = "Billing Details:";

                if (parts.headingText) {
                    // User requested no forced space after ':'
                    finalComment += parts.headingText;
                }
                else if (parts.beforeText) {
                    finalComment += parts.beforeText;
                }

                finalComment += "\n" + billingLines.join("\n");

                if (parts.afterText) {
                    finalComment += "\n" + parts.afterText;
                }
            }
            else {
                // No charge rows: manual comment must still be saved.
                finalComment = [
                    parts.headingText,
                    parts.beforeText,
                    parts.afterText
                ]
                .filter(Boolean)
                .join("\n")
                .trim();
            }

            setSectionComment(
                "hid_Billing",
                "Billing",
                finalComment.trim()
            );
        }

