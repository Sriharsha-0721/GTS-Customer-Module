@model GTSCustomerAPI.Web.Models.CustomerProfileViewModel

@{
    ViewData["Title"] = "Customer Profile";
    Layout = "_Layout";

    bool hasCust = Model != null && Model.CustId > 0;

    var nodes = new[]
    {
        "Billing",
        "Customer Service",
        "Dryer",
        "Driver",
        "Gen. Office",
        "Main Cleanroom",
        "Mending/Rework",
        "Merch. Control",
        "Office",
        "Packout",
        "Production",
        "Quality Assurance",
        "QA Inspector",
        "Receiving",
        "Shipping",
        "Soil",
        "Wash"
    };
}

@functions
{
    string HidId(string node)
    {
        return "hid_" +
            node.Replace(" ", "")
                .Replace(".", "")
                .Replace("/", "");
    }
}

<!-- =========================================================
     CUSTOMER MODULE TABS
========================================================= -->

<partial name="_TabBar" />

<div class="gts-content">

    <!-- =====================================================
         MESSAGES
    ====================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <!-- =====================================================
         CUSTOMER PROFILE FORM
    ====================================================== -->

    <form id="frmProfile"
          asp-controller="CustomerProfile"
          asp-action="Save"
          method="post">

        @Html.AntiForgeryToken()

        <!-- Keep these hidden values.
             Route/GID don't need to be DISPLAYED on Customer Profile. -->

        <input type="hidden"
               asp-for="CustId" />

        <input type="hidden"
               asp-for="CustNbr" />

        <input type="hidden"
               asp-for="CustName" />

        <input type="hidden"
               asp-for="Route" />

        <input type="hidden"
               asp-for="GID" />

        <input type="hidden"
               asp-for="MarketCenter" />

        <input type="hidden"
               asp-for="BillingCom"
               id="hid_Billing" />

        <input type="hidden"
               asp-for="CustSrvCom"
               id="hid_CustomerService" />

        <input type="hidden"
               asp-for="DryerCom"
               id="hid_Dryer" />

        <input type="hidden"
               asp-for="DriverCom"
               id="hid_Driver" />

        <input type="hidden"
               asp-for="GenOfficeCom"
               id="hid_GenOffice" />

        <input type="hidden"
               asp-for="MainCleanRoomCom"
               id="hid_MainCleanroom" />

        <input type="hidden"
               asp-for="MendCom"
               id="hid_MendingRework" />

        <input type="hidden"
               asp-for="MerControlCom"
               id="hid_MerchControl" />

        <input type="hidden"
               asp-for="OfficeCom"
               id="hid_Office" />

        <input type="hidden"
               asp-for="PackoutCom"
               id="hid_Packout" />

        <input type="hidden"
               asp-for="ProdCom"
               id="hid_Production" />

        <input type="hidden"
               asp-for="QACom"
               id="hid_QualityAssurance" />

        <input type="hidden"
               asp-for="QAInspCom"
               id="hid_QAInspector" />

        <input type="hidden"
               asp-for="ReceivingCom"
               id="hid_Receiving" />

        <input type="hidden"
               asp-for="ShippingCom"
               id="hid_Shipping" />

        <input type="hidden"
               asp-for="SoilCom"
               id="hid_Soil" />

        <input type="hidden"
               asp-for="WashCom"
               id="hid_Wash" />

        <input type="hidden"
               asp-for="FormulaData"
               id="FormulaData" />

        <input type="hidden"
               asp-for="ActiveSection"
               id="ActiveSection" />


        <!-- =================================================
             CUSTOMER INFORMATION
        ================================================== -->

        <div class="customer-profile-box">

            <div class="row g-3 align-items-end">

                <!-- Cust # -->

                <div class="col-md-2">

                    <label class="form-label">
                        Cust #
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@(hasCust ? Model.CustNbr : "")"
                           readonly />

                </div>


                <!-- Customer Name -->

                <div class="col-md-5">

                    <label class="form-label">
                        Customer
                    </label>

                    <input type="text"
                           class="form-control"
                           value="@Model.CustName"
                           readonly />

                </div>


                <!-- Select Customer -->

                <div class="col-md-2">

                    <a asp-controller="Customer"
                           asp-action="Index"
                           asp-route-showAll="true"
                           asp-route-returnTo="CustomerProfile"
                           class="btn primary-blue-btn w-100">
                        Select Customer
                    </a>

                </div>

            </div>


            <!-- SECOND ROW -->

            <div class="row g-3 mt-1">

                <!-- Sterilization -->

                <div class="col-md-3">

                    <label class="form-label">
                        Sterilization
                    </label>

                    <select asp-for="SterileCode"
                            id="ddlSterileCode"
                            class="form-select"
                            disabled="@(!hasCust)">

                        <option value="0">
                            Non-sterile
                        </option>

                        <option value="1">
                            Sterile-gamma
                        </option>

                        <option value="2">
                            Sterile-eto
                        </option>

                        <option value="3">
                            Sterile-e-beam
                        </option>

                    </select>

                </div>


                <!-- Ship Via -->

                <div class="col-md-2">

                    <label class="form-label">
                        Ship Via
                    </label>

                    <input asp-for="ShipVia"
                           class="form-control"
                           disabled="@(!hasCust)" />

                </div>


                <!-- Package -->

                <div class="col-md-2">

                    <label class="form-label">
                        Package
                    </label>

                    <input asp-for="Package"
                           class="form-control"
                           disabled="@(!hasCust)" />

                </div>

            </div>


            <!-- THIRD ROW -->

            <div class="row g-3 mt-1">

                <!-- Dosage -->

                <div class="col-md-3">

                    <label class="form-label d-block">
                        Dosage
                    </label>

                    <div class="d-flex gap-3">

                        <div class="form-check">

                            <input type="checkbox"
                                   class="form-check-input"
                                   id="chkLowDose"
                            @(Model.LowDose == true
                                                                   ? "checked"
                                                                   : "")
                            @(!hasCust
                                                                   ? "disabled"
                                                                   : "") />

                            <label class="form-check-label"
                                   for="chkLowDose">
                                Low Dose
                            </label>

                        </div>


                        <div class="form-check">

                            <input type="checkbox"
                                   class="form-check-input"
                                   id="chkHighDose"
                            @(Model.HighDose == true
                                                                   ? "checked"
                                                                   : "")
                            @(!hasCust
                                                                   ? "disabled"
                                                                   : "") />

                            <label class="form-check-label"
                                   for="chkHighDose">
                                High Dose
                            </label>

                        </div>

                    </div>

                </div>


                <!-- Property Mark -->

                <div class="col-md-3">

                    <label class="form-label">
                        Property Mark
                    </label>

                    <input asp-for="PropertyMark"
                           class="form-control"
                           disabled="@(!hasCust)" />

                </div>

            </div>


            <!-- FLAGS -->

            <div class="row mt-3">

                <div class="col-12">

                    <div class="d-flex gap-4 flex-wrap">

                        <div class="form-check">

                            <input type="checkbox"
                                   class="form-check-input"
                                   id="chkContaminated"
                                   name="CtmndFlg"
                                   value="1"
                            @(Model.CtmndFlg == 1
                                                                   ? "checked"
                                                                   : "")
                            @(!hasCust
                                                                   ? "disabled"
                                                                   : "") />

                            <label class="form-check-label"
                                   for="chkContaminated">
                                Contaminated Soil
                            </label>

                        </div>


                        <div class="form-check">

                            <input type="checkbox"
                                   class="form-check-input"
                                   id="chkDeliveryTicket"
                                   name="DelTicket"
                                   value="1"
                            @(Model.DelTicket == 1
                                                                   ? "checked"
                                                                   : "")
                            @(!hasCust
                                                                   ? "disabled"
                                                                   : "") />

                            <label class="form-check-label"
                                   for="chkDeliveryTicket">
                                Delivery Ticket
                            </label>

                        </div>


                        <div class="form-check">

                            <input type="checkbox"
                                   class="form-check-input"
                                   id="chkOnSiteInventory"
                                   name="OSSFlag"
                                   value="true"
                            @(Model.OSSFlag
                                                                   ? "checked"
                                                                   : "")
                            @(!hasCust
                                                                   ? "disabled"
                                                                   : "") />

                            <label class="form-check-label"
                                   for="chkOnSiteInventory">
                                On-site Inventory
                            </label>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             NO CUSTOMER SELECTED
        ================================================== -->
        @if (!hasCust)
        {
            <div class="alert alert-secondary mt-3">

                No customer selected.

                Click
                <strong>Select Customer</strong>
                to continue.

            </div>
        }


        <!-- =================================================
             PROFILE WORK AREA
        ================================================== -->
        @if (hasCust)
        {
            <div class="customer-profile-workspace mt-3">


                <!-- =========================================
                     LEFT MENU
                ========================================== -->

                <div class="customer-profile-menu">

                    @foreach (var node in nodes)
                    {
                        <div class="profile-menu-item"
                             data-node="@node"
                             data-hid="@HidId(node)">

                            @node

                        </div>
                    }

                </div>


                <!-- =========================================
                     RIGHT CONTENT
                ========================================== -->

                <div class="customer-profile-content">


                    <!-- Comment heading -->

                    <div class="profile-section-title"
                         id="sectionTitle">
                        Billing
                    </div>


                    <!-- Comment -->

                    <textarea id="txtComment"
                          rows="7"
                          maxlength="750"
                              class="form-control profile-comment">
                    </textarea>


                    <div id="charInfo"
                         class="profile-char-count">
                        0 / 750 characters
                    </div>


                    <!-- =====================================
                         BILLING
                    ====================================== -->
                    <div id="billingSection" style="display:none;">

                        <div class="row g-2 align-items-start">

                            <!-- TABLE AREA -->
                            <div class="col-md-10">

                                <div class="table-responsive">

                                    <table class="table table-sm gts-tbl-grid"
                                           id="billingTable">

                                        <thead>
                                            <tr>
                                                <th style="width:40%">
                                                    Charge Type
                                                </th>

                                                <th style="width:35%">
                                                    Charge Amount
                                                </th>

                                                <th style="width:25%; text-align:center">
                                                    Action
                                                </th>
                                            </tr>
                                        </thead>

                                        <tbody id="billingRows">
                                            <!-- Existing billing data comes here -->
                                        </tbody>

                                        <!-- ADD NEW ROW -->
                                        <tfoot id="billingAddRow"
                                               style="display:none">

                                            <tr>

                                                <td>
                                                    <select id="newChargeType"
                                                            class="form-select form-select-sm">

                                                        <option value="">
                                                            Select Charge Type
                                                        </option>

                                                    </select>
                                                </td>

                                                <td>
                                                    <input type="number"
                                                           id="newChargeAmount"
                                                           class="form-control form-control-sm"
                                                           placeholder="Enter Amount"
                                                           step="0.01"
                                                           min="0" />
                                                </td>

                                                <td class="text-center">

                                                    <button type="button"
                                                            class="btn btn-sm btn-secondary"
                                                            onclick="cancelBillingRow()">
                                                        Cancel
                                                    </button>

                                                </td>

                                            </tr>

                                        </tfoot>

                                    </table>

                                </div>

                                <div id="billingMessage"
                                     class="small mt-2">
                                </div>

                            </div>


                            <!-- RIGHT SIDE ICONS -->
               
                            <div class="col-md-2">

                                <div class="d-flex gap-2
                                    align-items-center
                                    justify-content-start
                                    mt-2">
                                    <!-- PLUS -->
                                    <button type="button"
                                            class="gts-circle-btn"
                                            title="Add Billing Charge"
                                            onclick="showBillingAddRow()">

                                        <span style="font-size:22px;
                                            line-height:1">
                                            +
                                        </span>

                                    </button>


                                    <!-- SAVE -->
                                    <button type="button"
                                            class="gts-circle-btn gts-circle-save"
                                            title="Save Billing Charge"
                                            onclick="saveBillingCharge()">

                                        <span style="font-size:18px">
                                            💾
                                        </span>

                                    </button>

                                </div>

                            </div>

                        </div>

                    </div>
                    <!-- =====================================
                         PACKOUT
                    ====================================== -->

                   <div id="packoutSection"
     class="profile-data-section"
     style="display:none">

    <div class="row g-2 align-items-start">

        <div class="col-md-10">

            <table class="table table-sm gts-tbl-grid">

                <thead>
                    <tr>
                        <th>Restriction</th>
                        <th>Item</th>
                        <th>Color</th>
                        <th>Size</th>
                        <th style="width:80px">
                            Action
                        </th>
                    </tr>
                </thead>

                <tbody id="packoutRows">
                </tbody>

                <tbody id="packoutAddRow"
       style="display:none">

    <tr>

        <td>
            <select id="newPkRestrict"
                    class="form-select form-select-sm">
                <option value="Yes">Yes</option>
                <option value="No">No</option>
            </select>
        </td>

        <td>
            <select id="newPkItem"
                    class="form-select form-select-sm">
                <option value="">
                    Select Item
                </option>
            </select>
        </td>

        <td>
            <input id="newPkColor"
                   class="form-control form-control-sm"
                   placeholder="Color" />
        </td>

        <td>
            <input id="newPkSize"
                   class="form-control form-control-sm"
                   placeholder="Size" />
        </td>

        <td class="text-center">
            <button type="button"
                    class="btn btn-sm btn-secondary"
                    onclick="cancelPackoutRow()">
                Cancel
            </button>
        </td>

    </tr>

</tbody>

            </table>

            <div id="packoutMessage"
                 class="small mt-2">
            </div>

        </div>


        <div class="col-md-2">

            <div class="d-flex gap-2 mt-2">

                <button type="button"
                        class="gts-circle-btn"
                        onclick="showPackoutAddRow()">
                    +
                </button>

                <button type="button"
                        class="gts-circle-btn gts-circle-save"
                        onclick="savePackout()">
                    💾
                </button>

            </div>

        </div>

    </div>

</div>
                    <!-- =====================================
                         WASH
                    ====================================== -->

                    <div id="washSection"
                         class="profile-data-section"
                         style="display:none">

                        <div class="row g-2 align-items-start">

                            <div class="col-md-10">

                                <table class="table table-sm gts-tbl-grid">

                                    <thead>
                                        <tr>
                                            <th style="width:45%">Garment Type</th>
                                            <th style="width:35%">Formula</th>
                                            <th style="width:20%; text-align:center">Action</th>
                                        </tr>
                                    </thead>

                                    <tbody id="washRows"></tbody>

                                    <tbody id="washAddRow" style="display:none">
                                        <tr>
                                            <td>
                                                <select id="newWashGarmentType"
                                                        class="form-select form-select-sm">
                                                    <option value="">Select Garment Type</option>
                                                </select>
                                            </td>

                                            <td>
                                                <input type="text"
                                                       id="newWashFormula"
                                                       class="form-control form-control-sm"
                                                       placeholder="Enter Formula" />
                                            </td>

                                            <td class="text-center">
                                                <button type="button"
                                                        class="btn btn-sm btn-secondary"
                                                        onclick="cancelWashRow()">
                                                    Cancel
                                                </button>
                                            </td>
                                        </tr>
                                    </tbody>

                                </table>

                                <div id="washMessage" class="small mt-2"></div>

                            </div>

                            <div class="col-md-2">
                                <div class="d-flex gap-2 mt-2">

                                    <button type="button"
                                            class="gts-circle-btn"
                                            title="Add Wash Formula"
                                            onclick="showWashAddRow()">
                                        +
                                    </button>

                                    <button type="button"
                                            class="gts-circle-btn gts-circle-save"
                                            title="Add Wash Formula Row"
                                            onclick="saveWashRow()">
                                        💾
                                    </button>

                                </div>
                            </div>

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 BOTTOM ACTIONS
            ================================================== -->

            <div class="d-flex align-items-center gap-2 mt-3">

                <button type="button"
                        class="btn btn-secondary">
                    # of Washes &amp; Cycles
                </button>

                <button type="button"
                        class="btn btn-secondary">
                    Special Lines
                </button>

                <button type="button"
                        class="btn btn-secondary">
                    Line Comments
                </button>

                <button type="submit"
                        class="btn primary-blue-btn">
                    Save
                </button>

            </div>
        }

    </form>

</div>

@section Scripts
{
    <script>

        // =====================================================
        // GLOBAL STATE
        // =====================================================

        let billingTypesLoaded = false;
        let billingData = [];

        
        let packoutData = [];

        let washData = [];


        // =====================================================
        // GLOBAL ADD/CANCEL FUNCTIONS
        // =====================================================

        function showBillingAddRow() {

            const row =
                document.getElementById(
                    "billingAddRow"
                );

            if (row) {
                row.style.display =
                    "table-row-group";
            }

            const ddl =
                document.getElementById(
                    "newChargeType"
                );

            if (ddl) {
                ddl.focus();
            }
        }


        function cancelBillingRow() {

            const row =
                document.getElementById(
                    "billingAddRow"
                );

            const ddl =
                document.getElementById(
                    "newChargeType"
                );

            const amount =
                document.getElementById(
                    "newChargeAmount"
                );

            if (ddl) {
                ddl.value = "";
            }

            if (amount) {
                amount.value = "";
            }

            if (row) {
                row.style.display =
                    "none";
            }
        }


        function showPackoutAddRow() {

    const row =
        document.getElementById(
            "packoutAddRow"
        );

    if (row) {
        row.style.display =
            "table-row-group";
    }

    const ddl =
        document.getElementById(
            "newPkItem"
        );

    if (ddl) {
        ddl.focus();
    }
}


        function cancelPackoutRow() {

            const row =
                document.getElementById(
                    "packoutAddRow"
                );

            const restrict =
                document.getElementById(
                    "newPkRestrict"
                );

            const item =
                document.getElementById(
                    "newPkItem"
                );

            const color =
                document.getElementById(
                    "newPkColor"
                );

            const size =
                document.getElementById(
                    "newPkSize"
                );

            if (restrict) {
                restrict.value = "Yes";
            }

            if (item) {
                item.value = "";
            }

            if (color) {
                color.value = "";
            }

            if (size) {
                size.value = "";
            }

            if (row) {
                row.style.display =
                    "none";
            }

            if (row) {
    row.style.display = "none";
}
        }


        // =====================================================
        // DOCUMENT READY
        // =====================================================

        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const items =
                    document.querySelectorAll(
                        ".profile-menu-item"
                    );

                const comment =
                    document.getElementById(
                        "txtComment"
                    );

                const title =
                    document.getElementById(
                        "sectionTitle"
                    );

                const charInfo =
                    document.getElementById(
                        "charInfo"
                    );

                let currentHiddenId =
                    "hid_Billing";


                // =============================================
                // HIDE BILLING / PACKOUT / WASH
                // =============================================

                function hideSpecialSections() {

                    const billing =
                        document.getElementById(
                            "billingSection"
                        );

                    const packout =
                        document.getElementById(
                            "packoutSection"
                        );

                    const wash =
                        document.getElementById(
                            "washSection"
                        );

                    if (billing) {
                        billing.style.display =
                            "none";
                    }

                    if (packout) {
                        packout.style.display =
                            "none";
                    }

                    if (wash) {
                        wash.style.display =
                            "none";
                    }
                }


                // =============================================
                // SAVE CURRENT COMMENT
                // =============================================

                function saveCurrentComment() {

                    const hidden =
                        document.getElementById(
                            currentHiddenId
                        );

                    if (hidden && comment) {

                        hidden.value =
                            comment.value;
                    }
                }


                // =============================================
                // LOAD COMMENT
                // =============================================

                function loadComment(
                    hiddenId
                ) {

                    const hidden =
                        document.getElementById(
                            hiddenId
                        );

                    if (!comment) {
                        return;
                    }

                    comment.value =
                        hidden
                            ? hidden.value
                            : "";

                    updateCharacterCount();
                }


                // =============================================
                // CHARACTER COUNT
                // =============================================

                function updateCharacterCount() {

                    if (!comment ||
                        !charInfo) {
                        return;
                    }

                    charInfo.innerText =
                        comment.value.length +
                        " / 750 characters";
                }


                // =============================================
                // LEFT MENU CLICK
                // =============================================

                items.forEach(
                    function (item) {

                        item.addEventListener(
                            "click",
                            async function () {

                                saveCurrentComment();

                                items.forEach(
                                    function (x) {

                                        x.classList.remove(
                                            "active"
                                        );
                                    }
                                );

                                item.classList.add(
                                    "active"
                                );

                                const node =
                                    item.dataset.node;

                                const activeSectionInput =
                                    document.getElementById(
                                        "ActiveSection"
                                    );

                                if (activeSectionInput) {
                                    activeSectionInput.value =
                                        node;
                                }

                                currentHiddenId =
                                    item.dataset.hid;

                                if (title) {
                                    title.innerText =
                                        node;
                                }

                                loadComment(
                                    currentHiddenId
                                );

                                hideSpecialSections();


                                // =============================
                                // BILLING
                                // =============================

                                if (node === "Billing") {

                                    const billing =
                                        document.getElementById(
                                            "billingSection"
                                        );

                                    if (billing) {
                                        billing.style.display =
                                            "block";
                                    }

                                    await loadBilling();
                                }


                                // =============================
                                // PACKOUT
                                // =============================

                                if (node === "Packout") {

                                    const packout =
                                        document.getElementById(
                                            "packoutSection"
                                        );

                                    if (packout) {
                                        packout.style.display =
                                            "block";
                                    }

                                    await loadPackout();
                                }


                                // =============================
                                // WASH
                                // =============================

                                if (node === "Wash") {

                                    const wash =
                                        document.getElementById(
                                            "washSection"
                                        );

                                    if (wash) {
                                        wash.style.display =
                                            "block";
                                    }

                                    await loadGarmentTypes();
                                    loadExistingWashFormula();
                                }

                            }
                        );

                    }
                );


                // =============================================
                // COMMENT INPUT
                // =============================================

                if (comment) {

                    comment.addEventListener(
                        "input",
                        updateCharacterCount
                    );
                }


                // =============================================
                // RESTORE ACTIVE SECTION AFTER SAVE
                // =============================================

                if (items.length > 0) {

                    const activeInput =
                        document.getElementById(
                            "ActiveSection"
                        );

                    const activeSection =
                        activeInput?.value
                        || "Billing";

                    let selectedItem =
                        null;

                    items.forEach(
                        function (item) {

                            if (item.dataset.node
                                === activeSection) {

                                selectedItem =
                                    item;
                            }
                        }
                    );

                    if (!selectedItem) {
                        selectedItem =
                            items[0];
                    }

                    selectedItem
                        .classList
                        .add("active");

                    const node =
                        selectedItem.dataset.node;

                    currentHiddenId =
                        selectedItem.dataset.hid;

                    if (title) {
                        title.innerText =
                            node;
                    }

                    loadComment(
                        currentHiddenId
                    );

                    hideSpecialSections();

                    if (node === "Billing") {

                        const billing =
                            document.getElementById(
                                "billingSection"
                            );

                        if (billing) {
                            billing.style.display =
                                "block";
                        }

                        loadBilling();
                    }

                    if (node === "Packout") {

                        const packout =
                            document.getElementById(
                                "packoutSection"
