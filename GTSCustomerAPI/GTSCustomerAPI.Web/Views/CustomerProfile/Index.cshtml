        function buildPackoutComment() {

            const hidden =
                document.getElementById("hid_Packout");

            const commentBox =
                document.getElementById("txtComment");

            const title =
                document.getElementById("sectionTitle");

            let existingText = "";

            if (
                title &&
                title.innerText.trim() === "Packout" &&
                commentBox
            ) {
                existingText = commentBox.value || "";
            }
            else if (hidden) {
                existingText = hidden.value || "";
            }

            const parts =
                extractGeneratedCommentParts(
                    existingText,
                    "Packout Restrictions:",
                    function (line) {
                        return /^Restriction\s*:\s*.*\|\s*Item\s*:\s*.*\|\s*Color\s*:\s*.*\|\s*Size\s*:/i.test(line);
                    }
                );

            // Support old heading without ':' so previous saved comments
            // do not duplicate after this update.
            if (!existingText.includes("Packout Restrictions:") &&
                existingText.includes("Packout Restrictions")) {
                const oldParts = extractGeneratedCommentParts(
                    existingText,
                    "Packout Restrictions",
                    function (line) {
                        return /^Restriction\s*:\s*.*\|\s*Item\s*:\s*.*\|\s*Color\s*:\s*.*\|\s*Size\s*:/i.test(line);
                    }
                );
                parts.headingText = parts.headingText || oldParts.headingText;
                parts.beforeText = parts.beforeText || oldParts.beforeText;
                parts.afterText = parts.afterText || oldParts.afterText;
            }

            const generatedLines = (packoutData || []).map(
                function (item) {
                    return (
                        "Restriction : " + (item.pkoutRestrict || "")
                        + " | Item : " + (item.item || "")
                        + " | Color : " + (item.color || "")
                        + " | Size : " + (item.size || "")
                        + ","
                    );
                }
            );

            let finalComment = "";

            if (generatedLines.length > 0) {
                finalComment = "Packout Restrictions:";

                if (parts.headingText) {
                    finalComment += parts.headingText;
                }
                else if (parts.beforeText) {
                    finalComment += parts.beforeText;
                }

                finalComment += "\n" + generatedLines.join("\n");

                if (parts.afterText) {
                    finalComment += "\n" + parts.afterText;
                }
            }
            else {
                finalComment = [
                    parts.headingText,
                    parts.beforeText,
                    parts.afterText
                ]
                .filter(Boolean)
                .join("\n")
                .trim();
            }

            setSectionComment(
                "hid_Packout",
                "Packout",
                finalComment.trim()
            );
        }



