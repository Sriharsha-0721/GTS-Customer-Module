<div class="customer-service-stage">

    <div class="cd-customer-service-box">

        <div class="cd-customer-service-confirmation">

            <div class="form-check">

                <input type="checkbox"
                       id="chkCustomerService"
                       class="form-check-input" />

                <label for="chkCustomerService"
                       class="form-check-label cd-customer-service-label">

                    Please confirm if the Garments-In-Service (PO Scans)
                    and RTS Ruin Reports have been run and the data
                    extracted to determine Customer Loss?

                </label>

            </div>

        </div>


        <div class="cd-customer-service-action">

            <button type="button"
                    id="btnCustomerServiceConfirm"
                    class="btn btn-outline-primary cd-action-btn"
                    disabled>

                Confirm

            </button>

        </div>

    </div>


    <div id="customerServiceMessage"
         class="cd-confirmation-message"
         style="display:none;">

        Customer Service checks confirmed successfully.

    </div>


    <div class="cd-navigation">

        <button type="button"
                id="btnCustomerServicePrevious"
                class="cd-arrow-btn"
                title="Previous">

            ←

        </button>


        <button type="button"
                id="btnCustomerServiceNext"
                class="cd-arrow-btn"
                title="Next">

            →

        </button>

    </div>

</div>