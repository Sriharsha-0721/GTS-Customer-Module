@model GTSCustomerAPI.Web.Models.UpdateCustomerViewModel

@{
    ViewData["Title"] = "Edit Customer";
    Layout = "_Layout";
}

<div class="container-fluid mt-3">

    <div class="d-flex
        justify-content-between
        align-items-center
        mb-3">

        <h5 class="mb-0 fw-bold">
            Edit Customer
        </h5>

        <a asp-controller="Customer"
               asp-action="Index"
               asp-route-showAll="true"
               class="btn btn-secondary btn-sm">

            ← Back to List

        </a>

    </div>


    <div class="card">

        <div class="card-body">

            <form asp-controller="Customer"
                  asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()


                <div class="row g-3">


                    <div class="col-md-6">

                        <label class="form-label">
                            Name
                        </label>

                        <input asp-for="Name"
                               class="form-control" />

                    </div>


                    <div class="col-md-3">

                        <label class="form-label">
                            Route
                        </label>

                        <input asp-for="Route"
                               class="form-control" />

                    </div>


                    <div class="col-md-3">

                        <label class="form-label">
                            Account
                        </label>

                        <input asp-for="Account"
                               class="form-control" />

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Address 1
                        </label>

                        <input asp-for="Addr1"
                               class="form-control" />

                    </div>


                    <div class="col-md-6">

                        <label class="form-label">
                            Address 2
                        </label>

                        <input asp-for="Addr2"
                               class="form-control" />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            City
                        </label>

                        <input asp-for="City"
                               class="form-control" />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            State
                        </label>

                        <input asp-for="State"
                               class="form-control" />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            Zip
                        </label>

                        <input asp-for="Zip"
                               class="form-control" />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            Phone
                        </label>

                        <input asp-for="Phone"
                               class="form-control" />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            Fax
                        </label>

                        <input asp-for="Fax"
                               class="form-control" />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            Freq
                        </label>

                        <input asp-for="Freq"
                               class="form-control" />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            PO Number
                        </label>

                        <input asp-for="PONumber"
                               class="form-control" />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            Bill Name
                        </label>

                        <input asp-for="BillName"
                               class="form-control" />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            Bill City
                        </label>

                        <input asp-for="BillCity"
                               class="form-control" />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            Bill State
                        </label>

                        <input asp-for="BillState"
                               class="form-control" />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            Bill Zip
                        </label>

                        <input asp-for="BillZipCod"
                               class="form-control" />

                    </div>


                    <div class="col-md-4">

                        <label class="form-label">
                            Updt User
                        </label>

                        <input asp-for="UpdtUser"
                               class="form-control" />

                    </div>


                    <div class="col-md-4
                        d-flex
                        align-items-end">

                        <div class="form-check">

                            <input asp-for="OSSFlag"
                                   class="form-check-input"
                                   type="checkbox" />

                            <label asp-for="OSSFlag"
                                   class="form-check-label">

                                On-Site Scanning

                            </label>

                        </div>

                    </div>

                </div>


                <div class="mt-4 d-flex gap-2">

                    <button type="submit"
                            class="btn btn-warning">

                        Update Customer

                    </button>


                    <a asp-controller="Customer"
                           asp-action="Index"
                           asp-route-showAll="true"
                           class="btn btn-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>