    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model GTSCustomerAPI.Web.Models.CreateCustomerViewModel
@{
    ViewData["Title"] = "Create Customer";
}

<div class="container mt-3" style="max-width:800px">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>Create Customer</h4>
        <a asp-action="Index" class="btn btn-secondary btn-sm">← Back to List</a>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Market Center *</label>
                        <input asp-for="MarketCenter" class="form-control form-control-sm" />
                        <span asp-validation-for="MarketCenter" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Cust Nbr *</label>
                        <input asp-for="CustNbr" class="form-control form-control-sm" />
                        <span asp-validation-for="CustNbr" class="text-danger small"></span>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">GID *</label>
                        <input asp-for="GID" class="form-control form-control-sm" />
                        <span asp-validation-for="GID" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Name</label>
                        <input asp-for="Name" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Route *</label>
                        <input asp-for="Route" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Account</label>
                        <input asp-for="Account" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Address 1</label>
                        <input asp-for="Addr1" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Address 2</label>
                        <input asp-for="Addr2" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">City</label>
                        <input asp-for="City" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">State</label>
                        <input asp-for="State" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Zip</label>
                        <input asp-for="Zip" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Phone</label>
                        <input asp-for="Phone" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Fax</label>
                        <input asp-for="Fax" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Freq</label>
                        <input asp-for="Freq" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Bill Name</label>
                        <input asp-for="BillName" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Bill City</label>
                        <input asp-for="BillCity" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Bill State</label>
                        <input asp-for="BillState" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">UpdtUser</label>
                        <input asp-for="UpdtUser" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <div class="form-check">
                            <input asp-for="OSSFlag" class="form-check-input" type="checkbox" />
                            <label class="form-check-label" asp-for="OSSFlag">OSS Flag</label>
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create Customer</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
