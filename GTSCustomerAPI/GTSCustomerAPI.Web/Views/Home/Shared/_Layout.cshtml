<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - GTS
    </title>


    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />


    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- DataTables - kept because other screens may use it -->
    <link rel="stylesheet"
          href="https://cdn.datatables.net/2.3.8/css/dataTables.bootstrap5.css" />


    <!-- Common GTS CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />


    <!-- Page Specific CSS -->
    @await RenderSectionAsync(
        "Styles",
        required: false
    )

</head>


<body>


    <!-- =========================================================
         TOP HEADER
    ========================================================== -->

    <header>

        <div class="container-fluid">

            <div class="row align-items-center">

                <!-- Logo -->

                <div class="col-md-3">

                    <div class="gts-logo">
                        VESTIS
                    </div>

                </div>


                <!-- System Title -->

                <div class="col-md-6 text-center">

                    <div class="gts-system-title">
                        Garment Tracking System
                    </div>

                </div>


                <!-- Header Actions -->

                <div class="col-md-3">

                    <div class="d-flex
                        align-items-center
                        justify-content-end
                        gap-3
                        flex-nowrap">


                        <div class="position-relative">

                            <i class="bi bi-bell-fill
                                text-success
                                fs-5">
                            </i>

                        </div>


                        <button type="button"
                                class="btn btn-sm gts-header-btn">

                            CSM

                        </button>


                        <button type="button"
                                class="btn btn-sm gts-header-btn">

                            Home

                        </button>


                        <button type="button"
                                class="btn btn-sm gts-header-btn">

                            Help

                        </button>


                        <div class="text-end small">

                            <strong>
                                Koyyana Hemasree
                            </strong>

                            <br />

                            Selected MC: 855

                        </div>


                        <i class="bi bi-power
                            text-danger
                            fs-4">
                        </i>

                    </div>

                </div>

            </div>

        </div>



        <!-- =====================================================
             MAIN NAVIGATION
        ====================================================== -->

        <nav class="navbar
            navbar-expand-lg
            primary-bg-color
            navbar-dark">

            <div class="container-fluid">


                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#gtsMainNavbar"
                        aria-controls="gtsMainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon">
                    </span>

                </button>



                <div class="collapse navbar-collapse"
                     id="gtsMainNavbar">


                    <ul class="navbar-nav me-auto">


                        <!-- =====================================
                             ADMINISTRATION
                        ====================================== -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">

                                Administration

                            </a>


                            <ul class="dropdown-menu">


                                <li>

                                    <a class="dropdown-item"
                                           asp-controller="CustomerProfile"
                                           asp-action="Index">

                                        Customer Profile

                                    </a>

                                </li>



                                <li class="dropdown-submenu">

                                    <a class="dropdown-item dropdown-toggle"
                                           href="#">

                                        Lost Business Administration

                                    </a>


                                    <ul class="dropdown-menu">

                                        <li>

                                            <a class="dropdown-item"
                                                   asp-controller="CustomerDeletion"
                                                   asp-action="Index">

                                                Customer Deletion

                                            </a>

                                        </li>

                                    </ul>

                                </li>

                            </ul>

                        </li>



                        <!-- =====================================
                             PRODUCTION
                        ====================================== -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                Production

                            </a>


                            <ul class="dropdown-menu">

                                <li>

                                    <a class="dropdown-item"
                                           href="#">

                                        Production Menu

                                    </a>

                                </li>

                            </ul>

                        </li>



                        <!-- =====================================
                             RECEIVERS
                        ====================================== -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                Receivers

                            </a>


                            <ul class="dropdown-menu">

                                <li>

                                    <a class="dropdown-item"
                                           href="#">

                                        Receiver Menu

                                    </a>

                                </li>

                            </ul>

                        </li>



                        <!-- =====================================
                             CONTAINERS
                        ====================================== -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                Containers

                            </a>


                            <ul class="dropdown-menu">

                                <li>

                                    <a class="dropdown-item"
                                           href="#">

                                        Container Menu

                                    </a>

                                </li>

                            </ul>

                        </li>



                        <!-- =====================================
                             STOCKROOM
                        ====================================== -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                Stockroom

                            </a>


                            <ul class="dropdown-menu">

                                <li>

                                    <a class="dropdown-item"
                                           href="#">

                                        Stockroom Menu

                                    </a>

                                </li>

                            </ul>

                        </li>



                        <!-- =====================================
                             QA
                        ====================================== -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                QA

                            </a>


                            <ul class="dropdown-menu">

                                <li>

                                    <a class="dropdown-item"
                                           href="#">

                                        QA Menu

                                    </a>

                                </li>

                            </ul>

                        </li>



                        <!-- =====================================
                             REPAIRS
                        ====================================== -->

                        <li class="nav-item">

                            <a class="nav-link"
                                   href="#">

                                Repairs

                            </a>

                        </li>



                        <!-- =====================================
                             UTILITIES
                        ====================================== -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                Utilities

                            </a>


                            <ul class="dropdown-menu">

                                <li>

                                    <a class="dropdown-item"
                                           href="#">

                                        Utilities Menu

                                    </a>

                                </li>

                            </ul>

                        </li>



                        <!-- =====================================
                             REPORTS
                        ====================================== -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                Reports

                            </a>


                            <ul class="dropdown-menu">

                                <li>

                                    <a class="dropdown-item"
                                           href="#">

                                        Reports Menu

                                    </a>

                                </li>

                            </ul>

                        </li>



                        <!-- =====================================
                             GARMENT REVIEW
                        ====================================== -->

                        <li class="nav-item">

                            <a class="nav-link"
                                   href="#">

                                Garment Review

                            </a>

                        </li>



                        <!-- =====================================
                             CSM MC ADMIN
                        ====================================== -->

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown">

                                CSM MC Admin

                            </a>


                            <ul class="dropdown-menu">

                                <li>

                                    <a class="dropdown-item"
                                           href="#">

                                        Admin Menu

                                    </a>

                                </li>

                            </ul>

                        </li>


                    </ul>

                </div>

            </div>

        </nav>

    </header>



    <!-- =========================================================
         PAGE CONTENT
    ========================================================== -->

    <main class="container-fluid py-3">

        @RenderBody()

    </main>



    <!-- =========================================================
         JAVASCRIPT
    ========================================================== -->

    <script src="~/lib/jquery/dist/jquery.min.js">
    </script>


    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js">
    </script>


    <!-- Kept for other modules that use DataTables -->

    <script src="https://cdn.datatables.net/2.3.8/js/dataTables.js">
    </script>

    <script src="https://cdn.datatables.net/2.3.8/js/dataTables.bootstrap5.js">
    </script>


    <script src="~/js/site.js"
            asp-append-version="true">
    </script>


    @await RenderSectionAsync(
        "Scripts",
        required: false
    )


</body>

</html>