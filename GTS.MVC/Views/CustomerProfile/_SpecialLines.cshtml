@model List<GTS.MVC.Models.SpecialLines.SpecialLineViewModel>

<div class="special-lines-container p-2">
    <div class="table-responsive">
        <table class="table table-bordered table-hover gts-grid" id="tblSpecialLines" style="width: 100%;">
            <thead>
                <tr>
                    <th style="width: 60px;" class="text-center">Select</th>
                    <th>Line</th>
                    <th>Item Code</th>
                    <th>Size</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <!-- data-order 1 for checked, 0 for unchecked enables sorting to top -->
                            <td class="text-center select-col" data-order="@(item.IsSelected ? "1" : "0")">
                                <input type="checkbox"
                                       class="chkSpecialLine"
                                       data-line="@item.Line"
                                @(item.IsSelected ? "checked=\"checked\"" : "") />
                            </td>
                            <td>@item.Line</td>
                            <td>@item.ItemCode</td>
                            <td>@(string.IsNullOrEmpty(item.Size) ? "NULL" : item.Size)</td>
                            <td>@item.Descr</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <button type="button" id="btnSaveSpecialLines" class="btn btn-primary btn-sm px-3" style="background-color: #0b2545; border-color: #0b2545;">
            Save
        </button>
        <button type="button" id="btnSpecialLinesExit" class="btn btn-danger btn-sm px-3 ms-2">
            Exit
        </button>
    </div>
</div>