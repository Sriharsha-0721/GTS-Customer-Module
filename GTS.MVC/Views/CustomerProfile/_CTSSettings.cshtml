@model GTS.MVC.Models.CTSSettings.CTSSettingsViewModel
@using GTS.MVC.Models.CustomerProfile
<div class="container mt-3">

    @{
        var headerModel = new CustomerViewModel
        {
            CustNo = Model.CustNo ?? 0,
            Name = Model.Customer!,
            Route = Model.Route ?? 0,
            Gid = Model.GID!
        };
    }

    @await Html.PartialAsync("_CustomerHeader", headerModel)

    <fieldset class="border p-3">

        <legend class="float-none w-auto px-2">
            CTS Settings
        </legend>

        <div class="form-check mb-3">
            <input asp-for="PrintIssueStatusFlag" class="form-check-input" />
            <label asp-for="PrintIssueStatusFlag" class="form-check-label"></label>
        </div>

        <div class="form-check mb-3">
            <input asp-for="PrintBornonDateFlag" class="form-check-input" />
            <label asp-for="PrintBornonDateFlag" class="form-check-label"></label>
        </div>

        <div class="form-check mb-3">
            <input asp-for="NOGFlag" class="form-check-input" />
            <label asp-for="NOGFlag" class="form-check-label"></label>
        </div>

        <div class="mb-3">
            <label asp-for="LabelHeader"></label>
            <input asp-for="LabelHeader" class="form-control" />
        </div>

    </fieldset>

    <div class="mt-3 text-end">

        <button id="btnSaveCTS" class="btn btn-success">
            Save
        </button>   

    </div>

</div>