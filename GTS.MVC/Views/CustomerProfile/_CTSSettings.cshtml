@model GTS.MVC.Models.CTSSettings.CTSSettingsViewModel
@using GTS.MVC.Models.CustomerProfile

<div class="container mt-3">

    @{
        var headerModel = new CustomerViewModel
        {
            CustNo = Model?.CustNo ?? 0,
            Name = Model?.Customer ?? string.Empty,
            Route = Model?.Route ?? 0,
            Gid = Model?.GID ?? string.Empty
        };
    }

    @await Html.PartialAsync("_CustomerHeader", headerModel)

    <fieldset class="border p-3">

        <legend class="float-none w-auto px-2">
            CTS Settings
        </legend>

        <div class="form-check mb-3">
            <input asp-for="PrintIssueStatusFlag" class="form-check-input" id="PrintIssueStatusFlag" />
            <label asp-for="PrintIssueStatusFlag" class="form-check-label">Print Issue Status</label>
        </div>

        <div class="form-check mb-3">
            <input asp-for="PrintBornonDateFlag" class="form-check-input" id="PrintBornonDateFlag" />
            <label asp-for="PrintBornonDateFlag" class="form-check-label">Print Born-on Date</label>
        </div>

        <div class="form-check mb-3">
            <input asp-for="NOGFlag" class="form-check-input" id="NOGFlag" />
            <label asp-for="NOGFlag" class="form-check-label">NOG Flag</label>
        </div>

        <div class="mb-3">
            <label asp-for="LabelHeader" class="form-label">Label Header</label>
            <input asp-for="LabelHeader" class="form-control" id="LabelHeader" maxlength="50" />
        </div>

    </fieldset>

    <div class="mt-3 text-end">
        <button id="btnSaveCTS" type="button" class="btn btn-success">
            Save
        </button>
    </div>

</div>