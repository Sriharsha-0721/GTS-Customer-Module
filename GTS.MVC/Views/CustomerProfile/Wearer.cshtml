@model GTS.MVC.Models.WearerViewModel

<div class="wearer-screen">

    <!-- CUSTOMER SECTION -->
    <fieldset>
        <legend>Customer</legend>

        <div class="row align-items-center mb-2">
            <div class="col-auto" style="width: 80px;">
                <label class="form-label">Customer #</label>
            </div>
            <div class="col-auto" style="width: 130px;">
                <input id="custNo" class="form-control" readonly />
            </div>

            <div class="col-auto" style="width: 95px; margin-left: 8px;">
                <label class="form-label">Customer Name</label>
            </div>
            <div class="col">
                <input id="custName" class="form-control" readonly />
            </div>

            <div class="col-auto">
                <button type="button"
                        id="btnSelectCustomer"
                        class="btn btn-secondary">
                    Select Customer
                </button>
            </div>
        </div>

        <div class="row align-items-center">
            <div class="col-auto" style="width: 80px;">
                <label class="form-label">Route</label>
            </div>
            <div class="col-auto" style="width: 130px;">
                <input id="route" class="form-control" readonly />
            </div>

            <div class="col-auto" style="width: 95px; margin-left: 8px;">
                <label class="form-label">GID</label>
            </div>
            <div class="col-auto" style="width: 130px;">
                <input id="gid" class="form-control" readonly />
            </div>
        </div>
    </fieldset>

    <!-- HIDDEN IDENTIFIERS -->
    <input type="hidden" id="hdnCustId" name="CustId" value="@Model?.CustId" />
    <input type="hidden" id="hdnWearerId" name="WearerId" value="@Model?.WearerId" />

    <!-- WEARER SECTION -->
    <fieldset>
        <legend>Wearer</legend>

        <!-- WEARER # WITH SEARCH / SELECT WEARER BUTTON -->
        <div class="row align-items-center mb-2">
            <div class="col-auto" style="width: 80px;">
                <label class="form-label">Wearer #</label>
            </div>
            <div class="col-auto" style="width: 130px;">
                <input asp-for="WearNbr" id="WearNbr" class="form-control" readonly />
            </div>
            <div class="col-auto">
                <button type="button"
                        id="btnOpenWearerModal"
                        class="btn btn-secondary">
                    Select Wearer
                </button>
            </div>
        </div>

        <div class="row align-items-center mb-2">
            <div class="col-auto" style="width: 80px;">
                <label class="form-label">First Name</label>
            </div>
            <div class="col-md-4">
                <input asp-for="FirstName" id="FirstName" class="form-control" readonly />
            </div>

            <div class="col-auto" style="width: 80px;">
                <label class="form-label">Last Name</label>
            </div>
            <div class="col-md-4">
                <input asp-for="LastName" id="LastName" class="form-control" readonly />
            </div>
        </div>

        <div class="row align-items-center mb-2">
            <div class="col-auto" style="width: 80px;">
                <label class="form-label">Locker</label>
            </div>
            <div class="col-md-2">
                <input asp-for="Locker" id="Locker" class="form-control" />
            </div>

            <div class="col-auto" style="width: 80px;">
                <label class="form-label">Lock Room</label>
            </div>
            <div class="col-md-2">
                <input asp-for="LockRm" id="LockRm" class="form-control" />
            </div>

            <div class="col-auto" style="width: 50px;">
                <label class="form-label">Sex</label>
            </div>
            <div class="col-md-2">
                <select asp-for="Sex" id="Sex" class="form-select">
                    <option value="true">Male</option>
                    <option value="false">Female</option>
                </select>
            </div>
        </div>
    </fieldset>

    <!-- ACTION BUTTONS -->
    <div class="text-end mt-3">
        <button type="button" id="btnPrevious" class="btn btn-secondary">Previous</button>
        <button type="button" id="btnNext" class="btn btn-secondary">Next</button>
        <button type="button" id="btnSaveWearer" class="btn btn-primary">Save</button>
    </div>

</div>

<!-- CONTAINER WHERE _WearerSelection.cshtml IS INJECTED -->
<div id="wearerModalContainer"></div>