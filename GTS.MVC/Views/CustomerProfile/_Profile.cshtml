@model GTS.MVC.Models.CustomerProfile.CustomerViewModel

<div class="customer-profile">

    <!-- CUSTOMER HEADER -->
    @await Html.PartialAsync("_CustomerProfileHeader", Model)

    <!-- MODULE AREA -->
    <div class="customer-module-area">

        <!-- LEFT MENU -->
        <div class="legacy-menu">

            <a id="lnkBilling"
               href="javascript:void(0)"
               class="legacy-menu-item">
                Billing
            </a>

            <a id="lnkCustomerService"
               href="javascript:void(0)"
               class="legacy-menu-item">
                Customer Service
            </a>

            <a id="lnkDryer"
               href="javascript:void(0)"
               class="legacy-menu-item">
                Dryer
            </a>

            <a id="lnkDriver"
               href="javascript:void(0)"
               class="legacy-menu-item">
                Driver
            </a>

            <a id="lnkGeneralOffice"
               href="javascript:void(0)"
               class="legacy-menu-item">
                Gen. Office
            </a>

            <a id="lnkMainCleanroom"
               href="javascript:void(0)"
               class="legacy-menu-item">
                Main Cleanroom
            </a>

            <a id="lnkMending"
               href="javascript:void(0)"
               class="legacy-menu-item">
                Mending / Rework
            </a>

            <a id="lnkMerch"
               href="javascript:void(0)"
               class="legacy-menu-item">
                Merch. Control
            </a>

            <a id="lnkOffice"
               href="javascript:void(0)"
               class="legacy-menu-item">
                Office
            </a>

            <a id="lnkPackout"
               href="javascript:void(0)"
               class="legacy-menu-item">
                Packout
            </a>

            <a id="lnkProduction"
               href="javascript:void(0)"
               class="legacy-menu-item">
                Production
            </a>

            <a id="lnkQA"
               href="javascript:void(0)"
               class="legacy-menu-item">
                Quality Assurance
            </a>

            <a id="lnkQAInspector"
               href="javascript:void(0)"
               class="legacy-menu-item">
                QA Inspector
            </a>

            <a id="lnkReceiving"
               href="javascript:void(0)"
               class="legacy-menu-item">
                Receiving
            </a>

            <a id="lnkShipping"
               href="javascript:void(0)"
               class="legacy-menu-item">
                Shipping
            </a>

            <a id="lnkSoil"
               href="javascript:void(0)"
               class="legacy-menu-item">
                Soil
            </a>

            <a id="lnkWash"
               href="javascript:void(0)"
               class="legacy-menu-item">
                Wash
            </a>

        </div>


        <!-- RIGHT WORKSPACE -->
        <div class="legacy-workspace">

            <div id="CustomerModuleContainer">

                <div class="module-placeholder">
                    <h5>Select a module from the left menu</h5>
                </div>

            </div>

        </div>

    </div>


    <!-- BOTTOM ACTIONS -->
    <div class="customer-profile-actions">

        <div class="customer-profile-actions-left">

            <button id="btnMaxWash"
                    type="button"
                    class="btn primary-blue-btn btn-sm">
                # of Washes
            </button>

            <button id="btnSpecialLines"
                    type="button"
                    class="btn btn-secondary btn-sm">
                Special Lines
            </button>

            <button id="btnLineComments"
                    type="button"
                    class="btn btn-secondary btn-sm">
                Line Comments
            </button>

        </div>

        <div class="customer-profile-actions-right">

            <button type="button"
                    class="btn btn-danger btn-sm">
                Exit
            </button>

            <button id="btnSaveCustomerProfile"
                    type="button"
                    class="btn btn-success btn-sm">
                Save
            </button>

        </div>

    </div>

</div>