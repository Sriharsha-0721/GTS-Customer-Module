@model GTS.MVC.Models.CustomerProfile.CustomerViewModel

<div class="container mt-3">

    @await Html.PartialAsync(
        "_CustomerHeader",
        Model)

    <div class="row mt-3">

        <div class="col-md-3">

            <div class="form-check">

<input asp-for="OSSFlag"
       id="ossFlag"
       class="form-check-input" />

<label asp-for="OSSFlag"
       class="form-check-label">
    Onsite Scanning
</label>

            </div>

        </div>

        <div class="col-md-3">

            <div class="form-check">

                <input asp-for="STFlag"
                       id="stFlag"
                       class="form-check-input" />

                <label asp-for="STFlag"
                       class="form-check-label">
                    Data Mart Extract
                </label>

            </div>

        </div>

    </div>

    <div class="mt-4 text-end">

        <button id="btnSaveCustomer"
                type="button"
                class="btn btn-primary">
            Save
        </button>

    </div>

</div>