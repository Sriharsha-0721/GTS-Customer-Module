@model GTS.MVC.Models.Billing.BillingViewModel

<div class="billing-wrapper">

    <!-- =====================================================
         BILLING NOTES
         ===================================================== -->

    <div class="row">

        <div class="col-md-9">

            <textarea id="txtBillingNotes"
                      class="billing-notes">@Model.BillingCom</textarea>

            <input type="hidden"
                   id="hdnBillingComment"
                   value="@Model.BillingCom" />

        </div>

    </div>


    <!-- =====================================================
         BILLING GRID
         ===================================================== -->

    <div class="row mt-2">

        <div class="col-md-9">

            <table class="table table-sm billing-grid"
                   id="tblBilling">

                <thead>

                    <tr>

                        <th>
                            Charge Type
                        </th>

                        <th width="180">
                            Charge Amount
                        </th>

                        <th width="70">
                        </th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.Charges)
                    {
                        <tr>

                            <td>
                                @item.ChargeType
                            </td>

                            <td>
                                @($"{Convert.ToDecimal(item.Charges):0.00}")
                            </td>

                            <td class="text-center">

                                <button type="button"
                                        class="deleteBilling iconButton"
                                        data-id="@item.BillingChargesId">
                                    <i class="bi bi-trash-fill"></i>
                                </button>

                            </td>

                        </tr>
                    }


                    <!-- NEW BILLING ROW -->

                    <tr id="newBillingRow"
                        style="display:none;">

                        <td>

                            <select id="ddlChargeType"
                                    class="form-select form-select-sm">

                                @foreach (var item in Model.ChargeTypes)
                                {
                                    <option value="@item.BillingDataId">
                                        @item.ChargeType
                                    </option>
                                }

                            </select>

                        </td>


                        <td>

                            <input id="txtChargeAmount"
                                   type="number"
                                   step="0.01"
                                   class="form-control form-control-sm" />

                        </td>


                        <td class="text-center">

<button type="button"
        id="btnCancelBilling"
        class="btn btn-sm btn-outline-danger">
    Cancel
</button>

                        </td>

                    </tr>

                </tbody>

            </table>

        </div>


        <!-- =================================================
             ACTION BUTTONS
             ================================================= -->

        <div class="col-md-3 billing-actions">

            <button type="button"
                    id="btnAddBilling"
                    class="circleButton">
                <i class="bi bi-plus-lg"></i>
            </button>


            <button type="button"
                    id="btnSaveBilling"
                    class="saveButton"
                    title="Save Billing Charge">

                <i class="bi bi-floppy-fill"></i>

            </button>

        </div>

    </div>

</div>