@model GTS.Application.DTOs.UpdateCustomerDTO

@{
    ViewData["Title"] = "Edit Customer";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Edit Customer</h2>
        <a asp-action="Index" class="btn btn-secondary">← Back to List</a>
    </div>

    <div class="card">
        <div class="card-body">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input type="hidden" asp-for="CustId" />

                <div class="row">
                    <div class="col-md-6">
                        <h6 class="text-muted">Basic Info</h6>
                        <hr />
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label"></label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="MarketCenter" class="form-label"></label>
                            <input asp-for="MarketCenter" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="CustNbr" class="form-label"></label>
                            <input asp-for="CustNbr" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Route" class="form-label"></label>
                            <input asp-for="Route" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="GID" class="form-label"></label>
                            <input asp-for="GID" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Freq" class="form-label"></label>
                            <input asp-for="Freq" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Contact" class="form-label"></label>
                            <input asp-for="Contact" class="form-control" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h6 class="text-muted">Address</h6>
                        <hr />
                        <div class="mb-3">
                            <label asp-for="Addr1" class="form-label"></label>
                            <input asp-for="Addr1" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Addr2" class="form-label"></label>
                            <input asp-for="Addr2" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="State" class="form-label"></label>
                            <input asp-for="State" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Zip" class="form-label"></label>
                            <input asp-for="Zip" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Phone" class="form-label"></label>
                            <input asp-for="Phone" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="Fax" class="form-label"></label>
                            <input asp-for="Fax" class="form-control" />
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <h6 class="text-muted">Billing Info</h6>
                        <hr />
                        <div class="mb-3">
                            <label asp-for="BillName" class="form-label"></label>
                            <input asp-for="BillName" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="BillAddr" class="form-label"></label>
                            <input asp-for="BillAddr" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="BillCity" class="form-label"></label>
                            <input asp-for="BillCity" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="BillState" class="form-label"></label>
                            <input asp-for="BillState" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="BillZipCod" class="form-label"></label>
                            <input asp-for="BillZipCod" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label asp-for="BillPhone" class="form-label"></label>
                            <input asp-for="BillPhone" class="form-control" />
                        </div>
                    </div>

                    <div class="col-md-6">
                        <h6 class="text-muted">Other Info</h6>
                        <hr />
                        <div class="mb-3">
                            <label asp-for="PONumber" class="form-label"></label>
                            <input asp-for="PONumber" class="form-control" />
                        </div>
                        <input type="hidden" asp-for="UpdtUser" value="1" />
                        <div class="mb-3">
                            <label asp-for="UpdtTime" class="form-label"></label>
                            <input asp-for="UpdtTime" class="form-control"
                                   type="datetime-local" />
                        </div>
                    </div>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-warning">Update Customer</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}