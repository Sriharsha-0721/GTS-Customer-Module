@model IEnumerable<GTS.Application.DTOs.CustomersSelListDto>

<div class="customer-search-container p-3 bg-white border rounded">
    <!-- Search Inputs -->
    <div class="row g-2 align-items-center mb-3">
        <div class="col-md-2">
            <input type="number" id="searchMC" class="form-control form-control-sm" placeholder="MC (e.g., 561)" value="" />
        </div>
        <div class="col-md-2">
            <input type="text" id="searchId" class="form-control form-control-sm" placeholder="Cust #" />
        </div>
        <div class="col-md-3">
            <input type="text" id="searchName" class="form-control form-control-sm" placeholder="Customer Name" />
        </div>
        <div class="col-md-2">
            <input type="text" id="searchCity" class="form-control form-control-sm" placeholder="City" />
        </div>
        <div class="col-auto">
            <button type="button" id="btnSearch" class="btn btn-primary btn-sm">Search</button>
            <button type="button" id="btnShowAll" class="btn btn-outline-primary btn-sm">Show All</button>
            <button type="button" id="btnClear" class="btn btn-secondary btn-sm">Clear</button>
        </div>
    </div>

    <div id="searchMessage" class="mb-2"></div>

    <!-- Results Table -->
    <div class="table-responsive border" style="max-height: 480px;">
        <table class="table table-sm table-hover table-striped mb-0 text-nowrap">
            <thead class="table-light sticky-top">
                <tr>
                    <th style="width: 70px;">Action</th>
                    <th>Cust #</th>
                    <th>Name</th>
                    <th>MC</th>
                    <th>Route</th>
                    <th>GID</th>
                    <th>Service Days</th>
                    <th>City</th>
                    <th>Phone</th>
                </tr>
            </thead>
            <tbody id="customerGrid">
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a href="javascript:void(0);"
                                   class="btn btn-primary btn-sm py-0 px-2 selectCustomer"
                                   data-custid="@item.CustId"
                                   data-custno="@item.CustNbr"
                                   data-name="@item.Name"
                                   data-mc="@item.MarketCenter"
                                   data-route="@item.Route"
                                   data-gid="@item.GID">
                                    Select
                                </a>
                            </td>
                            <td>@item.CustNbr</td>
                            <td>@item.Name</td>
                            <td>@item.MarketCenter</td>
                            <td>@item.Route</td>
                            <td>@item.GID</td>
                            <td>@item.WDay</td>
                            <td>@item.City</td>
                            <td>@item.Phone</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center text-muted py-3">No customers found.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>