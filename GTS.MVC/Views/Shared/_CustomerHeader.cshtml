@model GTS.MVC.Models.CustomerProfile.CustomerViewModel

<fieldset class="border p-3 mb-3">

    <legend class="float-none w-auto px-2">
        Customer
    </legend>

    <div class="row mb-3">

        <div class="col-md-2">
            <label>Cust #</label>
        </div>

        <div class="col-md-4">
            <input id="custNo"
                   class="form-control"
                   value="@Model?.CustNo"
                   readonly />
        </div>

        <div class="col-md-4">

            <button id="btnSelectCustomer"
                    type="button"
                    class="btn btn-secondary">

                Select Customer

            </button>

        </div>

    </div>

    <div class="row mb-3">

        <div class="col-md-2">
            <label>Name</label>
        </div>

        <div class="col-md-6">
            <input id="custName"
                   class="form-control"
                   value="@Model?.Name"
                   readonly />
        </div>

    </div>

    <div class="row">

        <div class="col-md-2">
            <label>Route</label>
        </div>

        <div class="col-md-2">
            <input id="route"
                   class="form-control"
                   value="@Model?.Route"
                   readonly />
        </div>

        <div class="col-md-2 text-end">
            <label>GID</label>
        </div>

        <div class="col-md-3">
            <input id="gid"
                   class="form-control"
                   value="@Model?.Gid"
                   readonly />
        </div>

    </div>

</fieldset>