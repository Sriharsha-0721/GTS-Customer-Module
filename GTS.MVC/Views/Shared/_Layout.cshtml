<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - GTS.MVC</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/gts.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/customerProfile.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/wearer.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
</head>

<body>

    <!-- =========================================================
         GTS HEADER
         ========================================================= -->

    <header class="gts-header">

        <!-- TOP HEADER -->
        <div class="gts-top-header">

            <!-- LEFT LOGO -->
            <div class="gts-logo-area">

                @* 
                   If you have the actual Vestis logo, put it here:
                   <img src="~/images/vestis-logo.png" class="gts-logo" />
                *@

                <div class="gts-logo-placeholder">
                    <span class="gts-logo-mark"></span>
                    <span class="gts-logo-text">vestis</span>
                </div>

            </div>


            <!-- CENTER TITLE -->
            <div class="gts-title-area">

                <h1>
                    Garment Tracking System
                </h1>

            </div>


            <!-- RIGHT HEADER -->
            <div class="gts-user-area">

                <button type="button"
                        class="gts-icon-button"
                        title="Notifications">
                    <i class="bi bi-bell-fill"></i>
                </button>

                <button type="button"
                        class="gts-orange-button">
                    CSM
                </button>

                <button type="button"
                        class="gts-orange-button">
                    Home
                </button>

                <button type="button"
                        class="gts-orange-button">
                    Help
                </button>


                <button type="button"
                        class="gts-power-button"
                        title="Logout">
                    <i class="bi bi-power"></i>
                </button>

            </div>

        </div>


<!-- =====================================================
             MAIN NAVIGATION
             ===================================================== -->
        <nav class="gts-main-nav">

            <div class="gts-nav-inner">

                <!-- ADMINISTRATION (DROPDOWN RETAINED) -->
                <div class="gts-nav-item gts-dropdown">

                    <a href="javascript:void(0);"
                       class="gts-nav-link"
                       id="administrationNav">
                        Administration
                        <span class="gts-arrow">▼</span>
                    </a>

                    <div class="gts-dropdown-menu">

                        <a href="javascript:void(0);"
                           class="gts-dropdown-item has-submenu">
                            User Management
                            <span>›</span>
                        </a>

                        <a asp-controller="CustomerProfile"
                           asp-action="Index"
                           class="gts-dropdown-item">
                            Customer Profile
                        </a>

                    </div>

                </div>


                <!-- PRODUCTION -->
                <div class="gts-nav-item">
                    <a href="javascript:void(0);" class="gts-nav-link">
                        Production
                    </a>
                </div>


                <!-- RECEIVERS -->
                <div class="gts-nav-item">
                    <a href="javascript:void(0);" class="gts-nav-link">
                        Receivers
                    </a>
                </div>


                <!-- CONTAINERS -->
                <div class="gts-nav-item">
                    <a href="javascript:void(0);" class="gts-nav-link">
                        Containers
                    </a>
                </div>


                <!-- STOCKROOM -->
                <div class="gts-nav-item">
                    <a href="javascript:void(0);" class="gts-nav-link">
                        Stockroom
                    </a>
                </div>


                <!-- QA -->
                <div class="gts-nav-item">
                    <a href="javascript:void(0);" class="gts-nav-link">
                        QA
                    </a>
                </div>


                <!-- REPAIRS -->
                <div class="gts-nav-item">
                    <a href="javascript:void(0);" class="gts-nav-link">
                        Repairs
                    </a>
                </div>


                <!-- UTILITIES -->
                <div class="gts-nav-item">
                    <a href="javascript:void(0);" class="gts-nav-link">
                        Utilities
                    </a>
                </div>


                <!-- REPORTS -->
                <div class="gts-nav-item">
                    <a href="javascript:void(0);" class="gts-nav-link">
                        Reports
                    </a>
                </div>


                <!-- GARMENT REVIEW -->
                <div class="gts-nav-item">
                    <a href="javascript:void(0);" class="gts-nav-link">
                        Garment Review
                    </a>
                </div>


                <!-- CSM MC ADMIN -->
                <div class="gts-nav-item">
                    <a href="javascript:void(0);" class="gts-nav-link">
                        CSM MC Admin
                    </a>
                </div>

            </div>

        </nav>

    </header>


    <!-- =========================================================
         PAGE CONTENT
         ========================================================= -->

    <main class="gts-page-container">

        @RenderBody()

    </main>


    <!-- =========================================================
         SCRIPTS
         ========================================================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- DataTables JS CDN -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/customerProfile.js" asp-append-version="true"></script>
    <script src="~/js/Speciallines.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>